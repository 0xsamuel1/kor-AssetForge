{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "SLO Compliance & Error Budgets (Target: 99.9% Uptime, p99 < 500ms)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 100,
          "min": 98,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 99.0 },
              { "color": "yellow", "value": 99.5 },
              { "color": "green", "value": 99.9 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "(1 - (sum(rate(slo_http_requests_total{status=~\"5..\"}[30d])) / sum(rate(slo_http_requests_total[30d])))) * 100",
          "legendFormat": "30-Day Availability",
          "refId": "A"
        }
      ],
      "title": "30-Day Rolling Availability SLO",
      "type": "gauge"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "green", "value": 50 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "clamp_min((1 - ((sum(rate(slo_http_requests_total{status=~\"5..\"}[30d])) / sum(rate(slo_http_requests_total[30d]))) / 0.001)) * 100, 0)",
          "legendFormat": "Budget Remaining",
          "refId": "A"
        }
      ],
      "title": "Monthly Error Budget Remaining",
      "type": "gauge"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.5 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 1 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(slo_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 Latency (SLO < 500ms)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(slo_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(slo_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 Latency",
          "refId": "C"
        }
      ],
      "title": "Latency Percentiles vs SLO (p99 < 500ms)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 5,
      "panels": [],
      "title": "Cache Performance & Resilience",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "green", "text": "CLOSED (Normal)" }, "1": { "color": "yellow", "text": "HALF-OPEN (Probing)" }, "2": { "color": "red", "text": "OPEN (Degraded to DB)" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 9 },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "cache_redis_circuit_breaker_state",
          "legendFormat": "Circuit Breaker State",
          "refId": "A"
        }
      ],
      "title": "Redis Circuit Breaker State",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "linear" },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 9 },
      "id": 7,
      "targets": [
        {
          "expr": "sum(rate(slo_http_requests_total[1m])) by (status)",
          "legendFormat": "Status {{ status }}",
          "refId": "A"
        }
      ],
      "title": "Request Throughput by Status Code",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "linear" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 9 },
      "id": 8,
      "targets": [
        {
          "expr": "rate(cache_degraded_requests_total[1m])",
          "legendFormat": "Cache Degraded to DB (RPS)",
          "refId": "A"
        },
        {
          "expr": "rate(slo_breach_total[1m])",
          "legendFormat": "SLO Breaches / sec",
          "refId": "B"
        }
      ],
      "title": "SLO Violations & Fallback Degraded Traffic",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["assetforge", "slo", "cache", "resilience"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "utc",
  "title": "AssetForge - Service Level Objectives (SLO)",
  "uid": "assetforge-slo-dash",
  "version": 1
}
