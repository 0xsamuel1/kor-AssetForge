# Production environment template for kor-AssetForge.
#
# Copy to .env.prod, fill in real values, and restrict permissions:
#     cp .env.prod.example .env.prod
#     chmod 600 .env.prod
#
# Run the production stack with:
#     docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# NOTE: passwords and signing keys are NOT stored here. They live in Docker
# secrets under ./secrets/ (see docs/DOCKER_DEPLOYMENT.md). This file only
# holds non-secret configuration.
#
# .env.prod is gitignored. Never commit real credentials.

# --- Application ---
APP_ENV=production
SERVER_PORT=8080
LOG_LEVEL=info
IMAGE_TAG=latest

# --- PostgreSQL identifiers (passwords come from secrets/postgres_password.txt) ---
POSTGRES_DB=assetforge
POSTGRES_USER=assetforge

# --- Read replicas (#323) ---
# Comma-separated replica DSNs. Leave empty to use the primary for reads.
DATABASE_REPLICA_URLS=
DB_REPLICA_LAG_THRESHOLD=30s
DB_REPLICA_FAILOVER_TO_PRIMARY=true

# --- Database connection pool ---
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# --- Stellar / Soroban ---
STELLAR_NETWORK=mainnet
STELLAR_HORIZON_URL=https://horizon.stellar.org

# --- Cache ---
CACHE_L1_MAX_ENTRIES=10000
CACHE_L1_MAX_SIZE_MB=64

# --- Backups (#321) ---
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=kor-assetforge/backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_HOUR=3

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=noreply@assetforge.example

# --- Networking ---
API_PORT=8080

# --- Secrets directory (files: postgres_password.txt, redis_password.txt, jwt_secret.txt, backup_encryption_key.txt) ---
SECRETS_DIR=./secrets
